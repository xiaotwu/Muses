<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.muses.app</string>
	<key>CFBundleName</key>
	<string>Muses</string>
	<key>CFBundleDisplayName</key>
	<string>Muses</string>
	<key>CFBundleExecutable</key>
	<string>Muses</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<false/>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- build-app.sh injects the project-owned Desktop OAuth client identifier. -->
	<key>MusesGoogleOAuthClientID</key>
	<string></string>
	<key>MusesGoogleOAuthClientSecret</key>
	<string></string>
	<key>MusesGoogleOAuthRedirectURI</key>
	<string>http://127.0.0.1:53682/</string>
	<!-- Release kill switch; user consent remains a separate default-off preference. -->
	<key>MusesWebHomeEnabled</key>
	<true/>
	<!-- Register muses:// URL scheme for Spotlight hits and external activation. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.muses.app.url.play</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>muses</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
</dict>
</plist>
